{
  "manifest_version": 3,
  "name": "SIP Phone",
  "version": "2.4.7",
  "description": "Side-panel softphone: click-to-call, incoming-call alerts, and your team's live presence - with the desktop app, or on its own.",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "SIP Phone",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": [
    "sidePanel",
    "nativeMessaging",
    "contextMenus",
    "notifications",
    "storage",
    "offscreen",
    "tts"
  ],
  "host_permissions": [
    "http://127.0.0.1:8088/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}
